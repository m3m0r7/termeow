{
  "name": "m3m0r7/termeow",
  "version": "0.1.0",
  "description": "A terminal rendered with SDL in PHP",
  "type": "project",
  "bin": ["bin/termeow"],
  "archive": {
    "exclude": ["/vendor/", "/@pnlx/", "/tmp/", "/.phpunit.result.cache"]
  },
  "license": "MIT",
  "require": {
    "php": ">=8.3",
    "ext-ffi": "*",
    "ext-mbstring": "*",
    "composer-runtime-api": "^2.0",
    "m3m0r7/pnl": "^1.1.2",
    "internal/toml": "^1.1",
    "symfony/console": "^7.3",
    "symfony/process": "^7.3"
  },
  "autoload": {
    "psr-4": {
      "Termeow\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Termeow\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "@php vendor/bin/phpunit",
    "stan": "@php vendor/bin/phpstan analyse --memory-limit=1G",
    "cs": "@php vendor/bin/phpcs",
    "check": ["@test", "@stan", "@cs"]
  },
  "require-dev": {
    "phpstan/phpstan": "^2.3",
    "phpunit/phpunit": "^12.5",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "config": {
    "platform": {
      "php": "8.3.0"
    }
  }
}
