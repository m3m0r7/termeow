#!/usr/bin/env php
<?php

declare(strict_types=1);

use Composer\InstalledVersions;
use Termeow\Application\TerminalApplication;
use Termeow\Infrastructure\Config\TerminalOptions;
use Termeow\Infrastructure\Emulation\LibvtermScreen;
use Termeow\Infrastructure\Input\SdlInputSource;
use Termeow\Infrastructure\Process\ScriptPtySession;
use Termeow\Infrastructure\Rendering\SdlRenderer;

$packageDirectory = dirname(__DIR__);
$autoload = isset($_composer_autoload_path) && is_string($_composer_autoload_path)
    ? $_composer_autoload_path
    : $packageDirectory . '/vendor/autoload.php';
if (!is_file($autoload)) {
    $autoload = dirname($packageDirectory, 2) . '/autoload.php';
}
require $autoload;
try {
    $argv = $_SERVER['argv'] ?? null;
    if (!is_array($argv) || !isset($argv[0]) || !is_string($argv[0])) {
        throw new RuntimeException('Command arguments are unavailable');
    }
    $argc = count($argv);
    $option = $argv[1] ?? null;
    if ($option !== null && !is_string($option)) {
        throw new InvalidArgumentException(TerminalOptions::usage());
    }

    $internal = getenv('TERM_PROGRAM') === 'termeow';
    if (basename($argv[0]) === 'termoew' && !$internal) {
        throw new RuntimeException('termoew is available only inside Termeow.');
    }
    if (($argc === 2 && in_array($option, ['-v', '--version'], true)) || ($internal && $argc === 1)) {
        $version = InstalledVersions::getPrettyVersion('m3m0r7/termeow') ?? '0.1.0-dev';
        echo "Termeow {$version}\n";
        echo 'PHP ', PHP_VERSION, "\n";
        echo "Author: m3m0r7\n";
        echo "Built with: pnl, SDL2, SDL_ttf, libvterm\n";
        exit(0);
    }
    if ($argc === 2 && $option === '--help') {
        echo TerminalOptions::usage();
        exit(0);
    }
    if ($argc !== 1) {
        throw new InvalidArgumentException(TerminalOptions::usage());
    }
    $pnlAutoload = $packageDirectory . '/@pnlx/autoload.php';
    if (!is_file($pnlAutoload)) {
        throw new RuntimeException(
            'Native bindings are missing. Run vendor/bin/pnl install in the Termeow package directory.',
        );
    }
    require $pnlAutoload;
    $directory = getcwd();
    if ($directory === false) {
        throw new RuntimeException('Could not determine the working directory');
    }
    $options = TerminalOptions::fromFile($packageDirectory . '/termeow.toml');
    $screen = new LibvtermScreen(30, 100, $options->colors);
    $renderer = new SdlRenderer($screen, $options);
    $session = new ScriptPtySession($screen->rows(), $screen->columns(), $directory);
    (new TerminalApplication($screen, $session, $renderer, new SdlInputSource()))->run();
} catch (Throwable $exception) {
    fwrite(STDERR, $exception->getMessage() . PHP_EOL);
    exit(1);
}
